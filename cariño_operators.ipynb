   "source": [
    "import math\n",
    "\n",
    "a = 20\n",
    "b = 0.2\n",
    "c = 2 * math.pi\n",
    "\n",
    "def ackley(a, b, c, d):\n",
    "    dimension = len(d)\n",
    "    part1 = -b * math.sqrt(1/dimension * sum(x**2 for x in d))\n",
    "    part2 = 1 / d * sum(math.cos(c * x) for x in d)\n",
    "\n",
    "    return -a * math.exp(part1) - math.exp(part2) + a + math.exp(1)\n"
   ]
